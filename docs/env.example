# Prismateams 3.4.12 – Beispiel-Umgebung
# Kopieren nach Projektroot: cp docs/env.example .env

# Optional: DEBUG, INFO (default prod), WARNING
LOG_LEVEL=INFO

SECRET_KEY=your-secret-key-here-change-this-in-production
# development | staging | production
FLASK_ENV=production
# True bei HTTPS (Default in production/staging). Bei reinem HTTP: False
SESSION_COOKIE_SECURE=True
# Optional: Remember-Me separat (Default = SESSION_COOKIE_SECURE)
# REMEMBER_COOKIE_SECURE=True

# Error-Testrouten /test/404 … nur für lokales Dev (Default an). Staging/Prod: aus.
# ENABLE_ERROR_TEST_ROUTES=False

# Passwort-Policy (Default: 12 Zeichen + Komplexität)
# PASSWORD_MIN_LENGTH=12
# PASSWORD_REQUIRE_COMPLEXITY=True

# Assessment: Portal-Nutzer ohne Admin-Rolle (kommagetrennt; nie Administrator)
# ASSESSMENT_PORTAL_DEFAULT_ROLES=Bewerter
# Assessment-Session-Timeouts (Stunden; Tracking über Flask-Session, nicht user_sessions)
# ASSESSMENT_SESSION_MAX_HOURS=12
# ASSESSMENT_SESSION_INACTIVITY_HOURS=8

# Öffentliche Basis-URL (optional; ergänzt Socket.IO-CORS-Allowlist)
# PUBLIC_BASE_URL=https://portal.example.com
# Socket.IO CORS: leer = same-origin; '*' = offen; sonst Komma-Liste
# SOCKETIO_CORS_ORIGINS=https://portal.example.com

DATABASE_URI=mysql+pymysql://Prismateams:password@localhost/teamportal

TIMEZONE=Europe/Berlin

CREDENTIAL_ENCRYPTION_KEY=your-credential-encryption-key-here
MAILBOX_ENCRYPTION_KEY=your-mailbox-encryption-key-here
MUSIC_ENCRYPTION_KEY=your-music-encryption-key-here
TOTP_ENCRYPTION_KEY=your-fernet-key-here

VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_CLAIM_EMAIL=admin@example.com

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=team@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=team@example.com
MAIL_SENDER_NAME=Prismateams

IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_USE_SSL=True

# Euro-Office Document Server (ENV-Keys historisch ONLYOFFICE_*; UI: Euro-Office)
# Neu: /eurooffice  |  Legacy-Proxy: /onlyoffice (beide zeigen auf denselben Container)
ONLYOFFICE_ENABLED=False
ONLYOFFICE_DOCUMENT_SERVER_URL=/eurooffice
ONLYOFFICE_SECRET_KEY=
ONLYOFFICE_PUBLIC_URL=
# Production/Staging: Secret setzen (JWT = Document Server JWT_SECRET). CSRF-Exempt der Callbacks ist an JWT gekoppelt.
# ONLYOFFICE_ALLOW_UNSIGNED_CALLBACKS=true  # nur wenn Document Server JWT_ENABLED=false

# Meetings (MiroTalk SFU) — öffentlicher Host, Join-API intern
# DNS: A/AAAA-Record meet.example.com → Server. Kein Path-Prefix /mirotalk/.
# WebRTC/Kamera brauchen HTTPS (Secure Context). Unter http://IP bleibt der Call schwarz.
# Secrets müssen 1:1 zu /var/lib/mirotalk-sfu/.env passen:
#   MIROTALK_API_KEY      = API_KEY_SECRET
#   MIROTALK_HOST_USER    = erster Teil von HOST_USERS (z. B. portal)
#   MIROTALK_HOST_PASSWORD = Passwort in HOST_USERS
# MIROTALK_ENABLED=True
# MIROTALK_URL=https://meet.example.com
# LAN ohne DNS (nur Dev): MIROTALK_URL=http://SERVER-IP:3010 — ohne HTTPS kein WebRTC
# MIROTALK_API_URL=http://127.0.0.1:3010
# MIROTALK_API_KEY=
# MIROTALK_HOST_USER=portal
# MIROTALK_HOST_PASSWORD=

# Multi-Worker / SocketIO / Rate-Limit: Redis empfohlen (Produktion)
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0
# Optional explizit (sonst REDIS_URL wenn REDIS_ENABLED=True):
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1
# Production/Staging ohne Redis: App startet sonst nicht. Notfall:
# RATELIMIT_ALLOW_MEMORY=true
# Sessions: bei Redis → server-seitig in Redis (Cookie = nur Session-ID).
# Ohne Redis → Dateien unter instance/flask_sessions/

# 2FA-E-Mail-Recovery (Default an). Abschalten stärkt TOTP bei Postfach-Risiko:
# TWO_FACTOR_EMAIL_RECOVERY_ENABLED=false

# CSRF-Token-Lebensdauer in Sekunden (Default 4h):
# WTF_CSRF_TIME_LIMIT=14400

# WebDAV HTML-Directory-Browser (Default aus; Info-Leak):
# WEBDAV_DIR_BROWSER=true

# Static-Cache in Sekunden (Default 1 Jahr). Sicher mit ?v=<BUILD> an Static-URLs.
# SEND_FILE_MAX_AGE_DEFAULT=31536000

# YouTube-Proxy: parallele Streams / Timeouts (Worker-Schutz)
# YOUTUBE_PROXY_MAX_CONCURRENT=4
# YOUTUBE_PROXY_STREAM_TIMEOUT=120
# YOUTUBE_PROXY_API_TIMEOUT=30

# Optional: WebAuthn Relying Party ID (Hostname ohne Port, z. B. portal.example.com)
# Lokal: http://localhost:5000 verwenden — 127.0.0.1 wird von Browsern für Passkeys abgelehnt.
# WEBAUTHN_RP_ID=portal.example.com

UPLOAD_FOLDER=uploads

EMAIL_HTML_MAX_LENGTH=2097152
EMAIL_TEXT_MAX_LENGTH=524288
EMAIL_HTML_STORAGE_TYPE=full

MEDIA_DOWNLOADER_RETENTION_HOURS=1
# Max. gleichzeitige Client-Downloads (Einzelvideos und Playlist-Jobs teilen sich dieses Limit)
MEDIA_DOWNLOADER_MAX_CONCURRENT=2
FFMPEG_PATH=

# Dateikonverter (optional; LibreOffice nur für Office-Dokumente)
FILE_CONVERTER_RETENTION_HOURS=24
FILE_CONVERTER_MAX_CONCURRENT=2
LIBREOFFICE_PATH=

# Datei-Papierkorb: Soft-gelöschte Dateien/Ordner nach N Tagen endgültig löschen (0 = aus).
# Überschreibbar unter Einstellungen → Datei-Einstellungen.
FILES_TRASH_DAYS=30

# Zugriffsprotokolle mit IP/UA: nach N Tagen löschen (0 = aus).
# Überschreibbar unter Einstellungen → System.
SESSION_RECORD_RETENTION_DAYS=30
SHARE_ACCESS_LOG_RETENTION_DAYS=90
