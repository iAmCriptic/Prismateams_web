# Prismateams – Docker Compose Umgebung
# Kopieren: cp docs/env.docker.example .env
# Dann Secrets ersetzen. Keys erzeugen z. B.:
#   docker compose run --rm --no-deps app python scripts/generate_encryption_keys.py
#   docker compose run --rm --no-deps app python scripts/generate_vapid_keys.py

# --- Compose / MySQL (werden von docker-compose.yml gelesen) ---
# App-Image (Docker Hub). Lokal: APP_IMAGE=prismateams-app:latest und compose build
APP_IMAGE=iamcriptic/prismateams:latest

MYSQL_DATABASE=teamportal
MYSQL_USER=teamportal
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Host-Bindings (Installer/Proxy nutzen Loopback)
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=5000
EUROOFFICE_HOST_BIND=127.0.0.1
EUROOFFICE_HOST_PORT=8080
EXCALIDRAW_HOST_BIND=127.0.0.1
EXCALIDRAW_HOST_PORT=8082
MIROTALK_HOST_PORT=3010
MIROTALK_UDP_MIN=40000
MIROTALK_UDP_MAX=40100

# --- App (Flask) ---
LOG_LEVEL=INFO
SECRET_KEY=change-me-flask-secret-key
FLASK_ENV=production
# Bei HTTPS hinter Proxy: True; sonst False (sonst keine Session-Cookies)
SESSION_COOKIE_SECURE=False
TIMEZONE=Europe/Berlin
# PUBLIC_BASE_URL=https://portal.example.com

# DATABASE_URI / REDIS werden in Compose für den App-Service gesetzt.
# Lokal zum Debuggen:
# DATABASE_URI=mysql+pymysql://teamportal:change-me-db-password@db:3306/teamportal
# REDIS_ENABLED=True
# REDIS_URL=redis://redis:6379/0

CREDENTIAL_ENCRYPTION_KEY=change-me-fernet-key
MAILBOX_ENCRYPTION_KEY=change-me-fernet-key
MUSIC_ENCRYPTION_KEY=change-me-fernet-key
TOTP_ENCRYPTION_KEY=change-me-fernet-key

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com

UPLOAD_FOLDER=uploads

# Optional Mail
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=

# --- Euro-Office (Profile: onlyoffice) ---
# Browser: Proxy /eurooffice → Host-Port 8080
# JWT muss mit Container JWT_SECRET übereinstimmen
ONLYOFFICE_ENABLED=False
ONLYOFFICE_DOCUMENT_SERVER_URL=/eurooffice
ONLYOFFICE_SECRET_KEY=
ONLYOFFICE_PUBLIC_URL=
# ONLYOFFICE_IMAGE=ghcr.io/euro-office/documentserver:latest

# --- Excalidraw Room (Profile: excalidraw) ---
EXCALIDRAW_ENABLED=False
EXCALIDRAW_URL=/excalidraw
EXCALIDRAW_ROOM_URL=/excalidraw-room
# EXCALIDRAW_ROOM_IMAGE=excalidraw/excalidraw-room:latest

# --- MiroTalk SFU (Profile: mirotalk) ---
# Browser: https://meet.example.com oder http://SERVER-IP:3010
# App→SFU intern: http://mirotalk:3010 (Compose setzt MIROTALK_API_URL default)
MIROTALK_ENABLED=False
# MIROTALK_URL=https://meet.example.com
# MIROTALK_API_URL=http://mirotalk:3010
MIROTALK_API_KEY=
MIROTALK_HOST_USER=portal
MIROTALK_HOST_PASSWORD=
MIROTALK_JWT_SECRET=
# Öffentliche IPv4 für WebRTC ICE (Pflicht hinter NAT/Cloud)
SFU_ANNOUNCED_IP=
# MIROTALK_CORS_ORIGIN=https://portal.example.com,https://meet.example.com
# MIROTALK_EMBED_ORIGINS=https://portal.example.com
# MIROTALK_IMAGE=mirotalk/sfu:latest
